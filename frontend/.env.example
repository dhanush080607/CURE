# Copy this file to `.env` and fill in your values.
# `.env` is gitignored - never commit real keys.
#
# NOTE: every VITE_* value is inlined into the public client bundle at build
# time. Anything here is readable by anyone who opens devtools. Only put
# PUBLIC, client-safe values here. Anything secret belongs in the backend.

# OpenWeatherMap API key - powers the Temperature / Wind / Cloud Cover map
# overlays. Free tier: https://openweathermap.org/api
# Leave blank and the app still runs: those three layers disable themselves
# and the radar + basemap keep working.
# DO NOT subscribe to "Weather Maps 2.0" - that tier costs $545/month.
# The legacy `map/*_new/*` tiles used here are covered by the free plan.
VITE_OWM_KEY=

# Base URL for the FastAPI backend. Requests go through the dev-server proxy
# defined in vite.config.js, so "/api" works locally with no CORS setup.
# Swap for the deployed origin (e.g. https://api.example.com) in production.
VITE_API_BASE=/api

# Set to "true" to skip Open-Meteo live station lookups and render the bundled
# sample data in src/data/mockWeatherData.js instead. Useful when the machine
# has no outbound internet.
VITE_USE_LIVE_STATIONS=false
